{
	// por ahora no funciona, creo que es por el ${file} que solo trata de abrir el file que se esta editando, pero no es el que se quiere compilar, sino el main.cpp, por ejemplo
	//abran el projecto con ctrl + shift + d, para abrir el debug y seleccionan su OS
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Mac)",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/src/*.cpp",
                "-I",
                "${workspaceFolder}/include",
                "-I",
                "/opt/homebrew/include",
                "-L",
                "/opt/homebrew/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-o",
                "${workspaceFolder}/build/game"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build (Windows)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/src/*.cpp",
                "-I",
                "${workspaceFolder}/include",
                "-I",
                "C:/SFML-3.1.0/include",
                "-L",
                "C:/SFML-3.1.0/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-o",
                "${workspaceFolder}/build/game.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run Game",
            "type": "shell",
            "command": "./build/game",
            "group": "test",
            "dependsOn": "Build (Mac)"
        }
    ]
}